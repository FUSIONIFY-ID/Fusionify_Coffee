generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  AWAITING_PAYMENT
  CONFIRMED
  PREPARING
  READY
  PICKED_UP
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  AUTOGOPAY
}

enum PaymentChannel {
  GOPAY_QRIS
  SHOPEEPAY_QRIS
  INTERACTIVE_QRIS
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum PhoneCountry {
  ID
  MY
}

enum AppLanguage {
  ID_ID
  MS_MY
  EN
}

enum OtpChannel {
  WHATSAPP
  SMS
}

enum OtpPurpose {
  REGISTER
  LOGIN_CHALLENGE
  RESET_PASSWORD
  CHANGE_PHONE
  DELETE_ACCOUNT
}

enum StaffRole {
  SUPER_ADMIN
  OWNER
  OPERATIONS_MANAGER
  OUTLET_MANAGER
  CASHIER
  BARISTA
  INVENTORY_STAFF
  CUSTOMER_SUPPORT
  FINANCE
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
}

enum LoyaltyEntryType {
  ORDER_REWARD
  CAMPAIGN_BONUS
  REDEEM_REWARD
  REFUND_REVERSAL
  MANUAL_ADJUSTMENT
}

model Outlet {
  id              String      @id
  name            String
  note            String      @default("")
  translations    Json?
  pickupEnabled   Boolean     @default(true)
  deliveryEnabled Boolean     @default(false)
  orders          Order[]
  staffUsers      StaffUser[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Category {
  id           String    @id
  name         String
  translations Json?
  sortOrder    Int       @default(0)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id             String          @id
  name           String
  description    String
  translations   Json?
  basePrice      Int
  active         Boolean         @default(true)
  isBestseller   Boolean         @default(false)
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  favoritedBy    FavoriteProduct[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ModifierGroup {
  id            String           @id
  productId     String
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  translations  Json?
  required      Boolean          @default(false)
  allowMultiple Boolean          @default(false)
  sortOrder     Int              @default(0)
  options       ModifierOption[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ModifierOption {
  id              String        @id
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  name            String
  translations    Json?
  priceDelta      Int           @default(0)
  isDefault       Boolean       @default(false)
  active          Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Order {
  id                String              @id @default(cuid())
  checkoutKey       String              @unique
  userId            String?
  user              CustomerUser?       @relation(fields: [userId], references: [id])
  outletId          String
  outlet            Outlet              @relation(fields: [outletId], references: [id])
  status            OrderStatus         @default(AWAITING_PAYMENT)
  currency          String              @default("IDR")
  subtotal          Int
  totalAmount       Int
  items             OrderItem[]
  payments          Payment[]
  statusEvents      OrderStatusEvent[]
  loyaltyEntry      LoyaltyLedgerEntry?
  loyaltyProcessedAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([outletId, status])
  @@index([userId, createdAt])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  productName       String
  basePrice         Int
  unitPrice         Int
  quantity          Int
  lineTotal         Int
  selectedModifiers Json
  createdAt         DateTime @default(now())

  @@index([orderId])
}

model Payment {
  id                    String          @id @default(cuid())
  idempotencyKey        String          @unique
  orderId               String
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              PaymentProvider
  channel               PaymentChannel
  status                PaymentStatus   @default(PENDING)
  amount                Int
  currency              String          @default("IDR")
  providerTransactionId String?         @unique
  providerOrderId       String?
  providerOrderSn       String?
  providerInvoiceId     String?
  providerRefNo         String?
  providerRawStatus     String?
  providerQrString      String?
  providerQrUrl         String?
  providerCheckoutUrl   String?
  providerExpiryTime    String?
  paidAt                DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([orderId, status])
}

model CustomerUser {
  id                String          @id @default(cuid())
  fullName          String
  phoneCountry      PhoneCountry
  phoneE164         String          @unique
  phoneVerifiedAt   DateTime
  email             String?         @unique
  passwordHash      String
  preferredLanguage AppLanguage     @default(ID_ID)
  birthDate         DateTime?
  avatarUrl         String?
  status            CustomerStatus  @default(ACTIVE)
  orders            Order[]
  sessions          UserSession[]
  loyaltyAccount    LoyaltyAccount?
  favoriteProducts  FavoriteProduct[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([phoneCountry, status])
}

model FavoriteProduct {
  id        String       @id @default(cuid())
  userId    String
  user      CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

model UserSession {
  id               String       @id @default(cuid())
  userId           String
  user             CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenHash  String       @unique
  refreshTokenHash String       @unique
  deviceName       String?
  platform         String?
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([userId, revokedAt])
}

model OtpChallenge {
  id                    String       @id @default(cuid())
  phoneCountry          PhoneCountry
  phoneE164             String
  channel               OtpChannel
  purpose               OtpPurpose
  language              AppLanguage
  codeHash              String
  expiresAt             DateTime
  attempts              Int          @default(0)
  maxAttempts           Int          @default(5)
  verifiedAt            DateTime?
  verificationTokenHash String?
  verificationExpiresAt DateTime?
  consumedAt            DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([phoneE164, purpose, createdAt])
}

model StaffUser {
  id                  String                @id @default(cuid())
  fullName            String
  email               String                @unique
  passwordHash        String
  role                StaffRole
  status              StaffStatus           @default(ACTIVE)
  outletId            String?
  outlet              Outlet?               @relation(fields: [outletId], references: [id])
  totpSecretEncrypted String?
  totpEnabledAt       DateTime?
  sessions            StaffSession[]
  loginChallenges     StaffLoginChallenge[]
  auditLogs           StaffAuditLog[]
  orderStatusEvents   OrderStatusEvent[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([role, status])
  @@index([outletId])
}

model StaffSession {
  id               String    @id @default(cuid())
  staffUserId      String
  staffUser        StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  accessTokenHash  String    @unique
  refreshTokenHash String    @unique
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([staffUserId, revokedAt])
}

model StaffLoginChallenge {
  id          String    @id @default(cuid())
  staffUserId String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([staffUserId, expiresAt])
}

model StaffAuditLog {
  id          String     @id @default(cuid())
  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  @@index([staffUserId, createdAt])
  @@index([action, createdAt])
}

model OrderStatusEvent {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  staffUserId String?
  staffUser   StaffUser?  @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime    @default(now())

  @@index([orderId, createdAt])
  @@index([staffUserId, createdAt])
}

model LoyaltyProgram {
  id            String   @id @default(cuid())
  currency      String   @unique
  spendUnit     Int
  pointsPerUnit Int
  active        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MembershipTier {
  id                     String   @id @default(cuid())
  currency               String
  rank                   Int
  name                   String
  translations           Json?
  minimumQualifyingSpend Int
  pointsMultiplierBps    Int      @default(10000)
  active                 Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([currency, rank])
  @@index([currency, active, minimumQualifyingSpend])
}

model MembershipProgress {
  id              String         @id @default(cuid())
  accountId       String
  account         LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  currency        String
  qualifyingSpend Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([accountId, currency])
  @@index([currency, qualifyingSpend])
}

model LoyaltyAccount {
  id                   String                 @id @default(cuid())
  userId               String                 @unique
  user                 CustomerUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance              Int                    @default(0)
  lifetimeEarned       Int                    @default(0)
  lifetimeRedeemed     Int                    @default(0)
  entries              LoyaltyLedgerEntry[]
  membershipProgresses MembershipProgress[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model LoyaltyLedgerEntry {
  id           String           @id @default(cuid())
  accountId    String
  account      LoyaltyAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type         LoyaltyEntryType
  points       Int
  balanceAfter Int
  orderId      String?          @unique
  order        Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  note         String?
  createdAt    DateTime         @default(now())

  @@index([accountId, createdAt])
  @@index([type, createdAt])
}
