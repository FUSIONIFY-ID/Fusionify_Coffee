generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  AWAITING_PAYMENT
  CONFIRMED
  PREPARING
  READY
  PICKED_UP
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  AUTOGOPAY
}

enum PaymentChannel {
  GOPAY_QRIS
  SHOPEEPAY_QRIS
  INTERACTIVE_QRIS
}

model Outlet {
  id              String   @id
  name            String
  note            String   @default("")
  pickupEnabled   Boolean  @default(true)
  deliveryEnabled Boolean  @default(false)
  orders          Order[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Category {
  id        String    @id
  name      String
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id             String          @id
  name           String
  description    String
  basePrice      Int
  active         Boolean         @default(true)
  isBestseller   Boolean         @default(false)
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ModifierGroup {
  id            String           @id
  productId     String
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  required      Boolean          @default(false)
  allowMultiple Boolean          @default(false)
  sortOrder     Int              @default(0)
  options       ModifierOption[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ModifierOption {
  id              String        @id
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  name            String
  priceDelta      Int           @default(0)
  isDefault       Boolean       @default(false)
  active          Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Order {
  id             String      @id @default(cuid())
  checkoutKey    String      @unique
  outletId       String
  outlet         Outlet      @relation(fields: [outletId], references: [id])
  status         OrderStatus @default(AWAITING_PAYMENT)
  currency       String      @default("IDR")
  subtotal       Int
  totalAmount    Int
  items          OrderItem[]
  payments       Payment[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([outletId, status])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  productName       String
  basePrice         Int
  unitPrice         Int
  quantity          Int
  lineTotal         Int
  selectedModifiers Json
  createdAt         DateTime @default(now())

  @@index([orderId])
}

model Payment {
  id                    String          @id @default(cuid())
  idempotencyKey        String          @unique
  orderId               String
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              PaymentProvider
  channel               PaymentChannel
  status                PaymentStatus   @default(PENDING)
  amount                Int
  currency              String          @default("IDR")
  providerTransactionId String?         @unique
  providerOrderId       String?
  providerOrderSn       String?
  providerInvoiceId     String?
  providerRefNo         String?
  providerRawStatus     String?
  providerQrString      String?
  providerQrUrl         String?
  providerCheckoutUrl   String?
  providerExpiryTime    String?
  paidAt                DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([orderId, status])
}
