generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  AWAITING_PAYMENT
  CONFIRMED
  PREPARING
  READY
  PICKED_UP
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  AUTOGOPAY
}

enum PaymentChannel {
  GOPAY_QRIS
  SHOPEEPAY_QRIS
  INTERACTIVE_QRIS
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum PhoneCountry {
  ID
  MY
}

enum AppLanguage {
  ID_ID
  MS_MY
  EN
}

enum OtpChannel {
  WHATSAPP
  SMS
}

enum OtpPurpose {
  REGISTER
  LOGIN_CHALLENGE
  RESET_PASSWORD
  CHANGE_PHONE
  DELETE_ACCOUNT
}

enum StaffRole {
  SUPER_ADMIN
  OWNER
  OPERATIONS_MANAGER
  OUTLET_MANAGER
  CASHIER
  BARISTA
  INVENTORY_STAFF
  CUSTOMER_SUPPORT
  FINANCE
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
}

enum LoyaltyEntryType {
  ORDER_REWARD
  CAMPAIGN_BONUS
  REDEEM_REWARD
  REFUND_REVERSAL
  MANUAL_ADJUSTMENT
}

enum VoucherDiscountType {
  FIXED_AMOUNT
  PERCENTAGE_BPS
}

enum CustomerVoucherStatus {
  AVAILABLE
  RESERVED
  REDEEMED
}

enum VoucherRedemptionStatus {
  RESERVED
  APPLIED
  RELEASED
}

enum InventoryItemType {
  INGREDIENT
  PACKAGING
  SUPPLY
}

enum StockMovementType {
  PURCHASE
  SALE
  WASTE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN
  EXPIRED
  DAMAGED
  STOCK_OPNAME
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum AssetStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
  LOST
}

enum DigitalBenefitType {
  WIFI
  AI
}

model Outlet {
  id                   String               @id
  name                 String
  note                 String               @default("")
  translations         Json?
  currency             String               @default("IDR")
  timezone             String               @default("Asia/Jakarta")
  pickupEnabled        Boolean              @default(true)
  deliveryEnabled      Boolean              @default(false)
  latitude             Float?
  longitude            Float?
  deliveryRadiusMeters Int?
  deliveryBaseFee      Int                  @default(0)
  deliveryPerKmFee     Int                  @default(0)
  orders               Order[]
  staffUsers           StaffUser[]
  vouchers             Voucher[]
  inventoryLevels      OutletInventory[]
  stockMovements       StockMovement[]
  purchaseOrders       PurchaseOrder[]
  assets               Asset[]
  wifiBenefitConfig    WifiBenefitConfig?
  aiBenefitConfig      AiBenefitConfig?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model Category {
  id           String    @id
  name         String
  translations Json?
  sortOrder    Int       @default(0)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id             String              @id
  name           String
  description    String
  translations   Json?
  basePrice      Int
  active         Boolean             @default(true)
  isBestseller   Boolean             @default(false)
  categoryId     String
  category       Category            @relation(fields: [categoryId], references: [id])
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  favoritedBy    FavoriteProduct[]
  recipeItems    ProductRecipeItem[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model ModifierGroup {
  id            String           @id
  productId     String
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  translations  Json?
  required      Boolean          @default(false)
  allowMultiple Boolean          @default(false)
  sortOrder     Int              @default(0)
  options       ModifierOption[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ModifierOption {
  id              String        @id
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  name            String
  translations    Json?
  priceDelta      Int           @default(0)
  isDefault       Boolean       @default(false)
  active          Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Order {
  id                     String                      @id @default(cuid())
  checkoutKey            String                      @unique
  userId                 String?
  user                   CustomerUser?               @relation(fields: [userId], references: [id])
  outletId               String
  outlet                 Outlet                      @relation(fields: [outletId], references: [id])
  status                 OrderStatus                 @default(AWAITING_PAYMENT)
  fulfillmentType        FulfillmentType             @default(PICKUP)
  scheduledFor           DateTime?
  savedAddressId         String?
  savedAddress           SavedAddress?               @relation(fields: [savedAddressId], references: [id], onDelete: SetNull)
  deliveryAddressSnapshot Json?
  deliveryDistanceMeters Int?
  deliveryFee            Int                         @default(0)
  currency               String                      @default("IDR")
  subtotal               Int
  discountAmount         Int                         @default(0)
  totalAmount            Int
  items                  OrderItem[]
  payments               Payment[]
  statusEvents           OrderStatusEvent[]
  loyaltyEntry           LoyaltyLedgerEntry?
  loyaltyProcessedAt     DateTime?
  voucherRedemption      VoucherRedemption?
  stockMovements         StockMovement[]
  digitalEntitlements    DigitalBenefitEntitlement[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([outletId, status])
  @@index([userId, createdAt])
  @@index([fulfillmentType, scheduledFor])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  productName       String
  basePrice         Int
  unitPrice         Int
  quantity          Int
  lineTotal         Int
  selectedModifiers Json
  createdAt         DateTime @default(now())

  @@index([orderId])
}

model Payment {
  id                    String          @id @default(cuid())
  idempotencyKey        String          @unique
  orderId               String
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              PaymentProvider
  channel               PaymentChannel
  status                PaymentStatus   @default(PENDING)
  amount                Int
  currency              String          @default("IDR")
  providerTransactionId String?         @unique
  providerOrderId       String?
  providerOrderSn       String?
  providerInvoiceId     String?
  providerRefNo         String?
  providerRawStatus     String?
  providerQrString      String?
  providerQrUrl         String?
  providerCheckoutUrl   String?
  providerExpiryTime    String?
  paidAt                DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([orderId, status])
}

model CustomerUser {
  id                String                    @id @default(cuid())
  fullName          String
  phoneCountry      PhoneCountry
  phoneE164         String                    @unique
  phoneVerifiedAt   DateTime
  email             String?                   @unique
  passwordHash      String
  preferredLanguage AppLanguage               @default(ID_ID)
  birthDate         DateTime?
  avatarUrl         String?
  status            CustomerStatus            @default(ACTIVE)
  orders            Order[]
  sessions          UserSession[]
  loyaltyAccount    LoyaltyAccount?
  favoriteProducts  FavoriteProduct[]
  savedAddresses    SavedAddress[]
  customerVouchers  CustomerVoucher[]
  rewardRedemptions RewardRedemption[]
  digitalEntitlements DigitalBenefitEntitlement[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([phoneCountry, status])
}

model FavoriteProduct {
  id        String       @id @default(cuid())
  userId    String
  user      CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

model UserSession {
  id               String       @id @default(cuid())
  userId           String
  user             CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenHash  String       @unique
  refreshTokenHash String       @unique
  deviceName       String?
  platform         String?
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([userId, revokedAt])
}

model OtpChallenge {
  id                    String       @id @default(cuid())
  phoneCountry          PhoneCountry
  phoneE164             String
  channel               OtpChannel
  purpose               OtpPurpose
  language              AppLanguage
  codeHash              String
  expiresAt             DateTime
  attempts              Int          @default(0)
  maxAttempts           Int          @default(5)
  verifiedAt            DateTime?
  verificationTokenHash String?
  verificationExpiresAt DateTime?
  consumedAt            DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([phoneE164, purpose, createdAt])
}

model StaffUser {
  id                    String                @id @default(cuid())
  fullName              String
  email                 String                @unique
  passwordHash          String
  role                  StaffRole
  status                StaffStatus           @default(ACTIVE)
  outletId              String?
  outlet                Outlet?               @relation(fields: [outletId], references: [id])
  totpSecretEncrypted   String?
  totpEnabledAt         DateTime?
  sessions              StaffSession[]
  loginChallenges       StaffLoginChallenge[]
  auditLogs             StaffAuditLog[]
  orderStatusEvents     OrderStatusEvent[]
  stockMovements        StockMovement[]
  purchaseOrdersCreated PurchaseOrder[]        @relation("PurchaseOrderCreatedBy")
  purchaseOrdersReceived PurchaseOrder[]       @relation("PurchaseOrderReceivedBy")
  assetMaintenances     AssetMaintenance[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([role, status])
  @@index([outletId])
}

model StaffSession {
  id               String    @id @default(cuid())
  staffUserId      String
  staffUser        StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  accessTokenHash  String    @unique
  refreshTokenHash String    @unique
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([staffUserId, revokedAt])
}

model StaffLoginChallenge {
  id          String    @id @default(cuid())
  staffUserId String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([staffUserId, expiresAt])
}

model StaffAuditLog {
  id          String     @id @default(cuid())
  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  @@index([staffUserId, createdAt])
  @@index([action, createdAt])
}

model OrderStatusEvent {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  staffUserId String?
  staffUser   StaffUser?   @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
  @@index([staffUserId, createdAt])
}

model LoyaltyProgram {
  id            String   @id @default(cuid())
  currency      String   @unique
  spendUnit     Int
  pointsPerUnit Int
  active        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MembershipTier {
  id                     String   @id @default(cuid())
  currency               String
  rank                   Int
  name                   String
  translations           Json?
  minimumQualifyingSpend Int
  pointsMultiplierBps    Int      @default(10000)
  active                 Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([currency, rank])
  @@index([currency, active, minimumQualifyingSpend])
}

model MembershipProgress {
  id              String         @id @default(cuid())
  accountId       String
  account         LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  currency        String
  qualifyingSpend Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([accountId, currency])
  @@index([currency, qualifyingSpend])
}

model LoyaltyAccount {
  id                   String               @id @default(cuid())
  userId               String               @unique
  user                 CustomerUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance              Int                  @default(0)
  lifetimeEarned       Int                  @default(0)
  lifetimeRedeemed     Int                  @default(0)
  entries              LoyaltyLedgerEntry[]
  membershipProgresses MembershipProgress[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model LoyaltyLedgerEntry {
  id           String           @id @default(cuid())
  accountId    String
  account      LoyaltyAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type         LoyaltyEntryType
  points       Int
  balanceAfter Int
  orderId      String?          @unique
  order        Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  note         String?
  createdAt    DateTime         @default(now())

  @@index([accountId, createdAt])
  @@index([type, createdAt])
}

model Voucher {
  id             String              @id @default(cuid())
  code           String              @unique
  title          String
  description    String              @default("")
  translations   Json?
  currency       String
  discountType   VoucherDiscountType
  discountValue  Int
  minimumSpend   Int                 @default(0)
  maximumDiscount Int?
  outletId       String?
  outlet         Outlet?             @relation(fields: [outletId], references: [id], onDelete: SetNull)
  validFrom      DateTime
  validUntil     DateTime
  active         Boolean             @default(false)
  customerVouchers CustomerVoucher[]
  rewardItems    RewardCatalogItem[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([currency, active, validFrom, validUntil])
  @@index([outletId, active])
}

model CustomerVoucher {
  id          String                @id @default(cuid())
  userId      String
  user        CustomerUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucherId   String
  voucher     Voucher               @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  status      CustomerVoucherStatus @default(AVAILABLE)
  source      String                @default("CAMPAIGN")
  issuedAt    DateTime              @default(now())
  expiresAt   DateTime?
  redemption  VoucherRedemption?
  rewardRedemption RewardRedemption?

  @@index([userId, status, issuedAt])
  @@index([voucherId])
}

model VoucherRedemption {
  id                String                  @id @default(cuid())
  customerVoucherId String                  @unique
  customerVoucher   CustomerVoucher         @relation(fields: [customerVoucherId], references: [id], onDelete: Cascade)
  orderId           String                  @unique
  order             Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status            VoucherRedemptionStatus @default(RESERVED)
  discountAmount    Int
  reservedAt        DateTime                @default(now())
  appliedAt         DateTime?
  releasedAt        DateTime?

  @@index([status, reservedAt])
}

model RewardCatalogItem {
  id            String             @id @default(cuid())
  title         String
  description   String             @default("")
  translations  Json?
  currency      String
  pointsCost    Int
  voucherId     String
  voucher       Voucher            @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  active        Boolean            @default(false)
  stockLimit    Int?
  redeemedCount Int                @default(0)
  redemptions   RewardRedemption[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([currency, active, pointsCost])
}

model RewardRedemption {
  id                String            @id @default(cuid())
  idempotencyKey    String            @unique
  userId            String
  user              CustomerUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardItemId      String
  rewardItem        RewardCatalogItem @relation(fields: [rewardItemId], references: [id], onDelete: Restrict)
  customerVoucherId String            @unique
  customerVoucher   CustomerVoucher   @relation(fields: [customerVoucherId], references: [id], onDelete: Restrict)
  pointsSpent       Int
  createdAt         DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([rewardItemId, createdAt])
}

model SavedAddress {
  id            String       @id @default(cuid())
  userId        String
  user          CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  recipientName String
  phoneE164     String
  line1         String
  line2         String?
  city          String
  region        String?
  postalCode    String?
  country       PhoneCountry
  latitude      Float
  longitude     Float
  deliveryNotes String?
  isDefault     Boolean      @default(false)
  orders        Order[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, isDefault])
}

model InventoryItem {
  id              String            @id @default(cuid())
  sku             String            @unique
  name            String
  type            InventoryItemType
  baseUnit        String
  costPerBaseUnit Int               @default(0)
  active          Boolean           @default(true)
  recipeItems     ProductRecipeItem[]
  outletLevels    OutletInventory[]
  movements       StockMovement[]
  purchaseItems   PurchaseOrderItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([type, active])
}

model ProductRecipeItem {
  id                String        @id @default(cuid())
  productId         String
  product           Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItemId   String
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantityBaseUnit  Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([productId, inventoryItemId])
  @@index([inventoryItemId])
}

model OutletInventory {
  id               String        @id @default(cuid())
  outletId         String
  outlet           Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  inventoryItemId  String
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  onHandBaseUnit   Int           @default(0)
  reorderPointBaseUnit Int       @default(0)
  updatedAt        DateTime      @updatedAt

  @@unique([outletId, inventoryItemId])
  @@index([outletId, onHandBaseUnit])
}

model StockMovement {
  id               String            @id @default(cuid())
  outletId         String
  outlet           Outlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)
  inventoryItemId  String
  inventoryItem    InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  type             StockMovementType
  quantityBaseUnit Int
  balanceAfterBaseUnit Int
  reason           String?
  orderId          String?
  order            Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  staffUserId      String?
  staffUser        StaffUser?        @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())

  @@index([outletId, inventoryItemId, createdAt])
  @@index([orderId, createdAt])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  active         Boolean         @default(true)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([active, name])
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  supplierId       String
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  outletId         String
  outlet           Outlet              @relation(fields: [outletId], references: [id], onDelete: Restrict)
  status           PurchaseOrderStatus @default(DRAFT)
  currency         String
  notes            String?
  createdById      String
  createdBy        StaffUser           @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  receivedById     String?
  receivedBy       StaffUser?          @relation("PurchaseOrderReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  orderedAt        DateTime?
  receivedAt       DateTime?
  items            PurchaseOrderItem[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([outletId, status, createdAt])
  @@index([supplierId, status])
}

model PurchaseOrderItem {
  id                String        @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItemId   String
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantityBaseUnit  Int
  receivedBaseUnit  Int           @default(0)
  unitCost          Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([purchaseOrderId, inventoryItemId])
}

model Asset {
  id             String            @id @default(cuid())
  assetTag       String            @unique
  outletId       String
  outlet         Outlet            @relation(fields: [outletId], references: [id], onDelete: Restrict)
  name           String
  category       String
  status         AssetStatus       @default(ACTIVE)
  purchaseDate   DateTime?
  purchaseCost   Int?
  serialNumber   String?
  notes          String?
  maintenances   AssetMaintenance[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([outletId, status])
}

model AssetMaintenance {
  id          String    @id @default(cuid())
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  description String
  cost        Int?
  performedAt DateTime
  createdAt   DateTime  @default(now())

  @@index([assetId, performedAt])
}

model WifiBenefitConfig {
  id                  String   @id @default(cuid())
  outletId            String   @unique
  outlet              Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ssid                 String
  passwordEncrypted    String
  entitlementHours     Int      @default(8)
  active               Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AiBenefitConfig {
  id                  String   @id @default(cuid())
  outletId            String   @unique
  outlet              Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  dailyQuota          Int      @default(30)
  entitlementHours    Int      @default(24)
  active               Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model DigitalBenefitEntitlement {
  id               String             @id @default(cuid())
  userId           String
  user             CustomerUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type             DigitalBenefitType
  payloadEncrypted String?
  quotaTotal       Int?
  quotaUsed        Int                @default(0)
  validFrom        DateTime           @default(now())
  validUntil       DateTime
  revokedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([orderId, type])
  @@index([userId, type, validUntil])
}
